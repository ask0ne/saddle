{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "pill",
  "description": "Capability for the floating pill window",
  "windows": ["pill"],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "core:window:allow-set-resizable",
    "core:menu:allow-new",
    "core:menu:allow-popup"
  ]
}
